# =============================================================================
# Robotic Arm Vision - Environment Configuration
# =============================================================================

# --- DEVELOPMENT (Localhost Web Testing) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/robot
VITE_SIGNALING_URL=ws://localhost:8000/ws/signaling

# --- DEVELOPMENT (Android Phone on Local Wi-Fi Network) ---
# Replace with your computer's LAN IPv4 address (found via ipconfig / ifconfig):
# VITE_API_URL=http://192.168.1.50:8000
# VITE_WS_URL=ws://192.168.1.50:8000/ws/robot
# VITE_SIGNALING_URL=ws://192.168.1.50:8000/ws/signaling

# --- PRODUCTION (Public Cloud Backend Deployment) ---
# Replace with your actual public FastAPI backend domain (HTTPS/WSS):
# VITE_API_URL=https://YOUR_PUBLIC_FASTAPI_BACKEND_URL
# VITE_WS_URL=wss://YOUR_PUBLIC_FASTAPI_BACKEND_URL/ws/robot
# VITE_SIGNALING_URL=wss://YOUR_PUBLIC_FASTAPI_BACKEND_URL/ws/signaling
